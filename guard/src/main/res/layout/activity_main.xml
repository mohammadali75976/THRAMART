<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WA View Once Guard"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Settings protected by company PIN"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_background"
            android:text="Accessibility status"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Important disclosure: this app uses Android Accessibility only while WhatsApp or WhatsApp Business is open. It checks visible control labels and positions so it can cover the View Once button. It does not save chats, contacts, photos, videos, voice notes, or passwords, and it has no Internet permission."
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/masterEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="Enable View Once blocker" />

        <CheckBox
            android:id="@+id/whatsappEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Protect normal WhatsApp" />

        <CheckBox
            android:id="@+id/businessEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Protect WhatsApp Business" />

        <CheckBox
            android:id="@+id/autoDetectEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Automatic button detection" />

        <CheckBox
            android:id="@+id/zeroGapEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Zero-gap mode (always block the calibrated spot while WhatsApp is open)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zero-gap mode removes the reaction delay. It may also cover another control at the same screen position outside the media preview."
            android:textSize="13sp" />

        <TextView
            android:id="@+id/blockerSizeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Red circle size: 88 dp"
            android:textSize="18sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/blockerSizeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="92"
            android:progress="40" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Move left for a smaller blocker or right for a larger blocker. After changing size, calibrate again for the best position."
            android:textSize="13sp" />

        <Button
            android:id="@+id/openAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="1. Enable Accessibility Service" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Fallback calibration"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use calibration if automatic detection misses the button. The app opens WhatsApp; select a photo/video. On the preview screen, drag the red circle over the ① button and tap SAVE." />

        <Button
            android:id="@+id/calibrateWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="2A. Calibrate WhatsApp" />

        <Button
            android:id="@+id/calibrateBusiness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2B. Calibrate WhatsApp Business" />

        <Button
            android:id="@+id/resetCalibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset saved calibration" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Prototype limitations"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="28dp"
            android:text="This is a test prototype, not a guaranteed security control. The PIN protects this settings screen only. A user who can disable Accessibility, clear app data, or uninstall the app can bypass it; company enforcement needs Android Enterprise/MDM." />

    </LinearLayout>
</ScrollView>
